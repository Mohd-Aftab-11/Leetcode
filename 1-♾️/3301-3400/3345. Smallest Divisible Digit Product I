class Solution {
    public int smallestNumber(int n, int t) {
        int num = n;
        while (true) {
            if (isValid(num, t)) {
                return num;
            }
            num++;
        }
    }
    private boolean isValid(int num, int t) {
        int product = 1;
        int temp = num;
        
        if (num == 0) {
            return t == 0 || t == 1;
        }
        while (temp > 0) {
            int digit = temp % 10;
            product *= digit;
            temp /= 10;
            
            if (product == 0) {
                return true;
            }
        }
        return product % t == 0;
    }
}
